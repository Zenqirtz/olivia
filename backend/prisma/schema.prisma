// ============================================
// Prisma Schema - Smarternak IoT Egg Quality Monitoring System
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  admin
  superadmin
}

enum EggQuality {
  good
  bad
  uncertain
}

enum ReportType {
  kualitas_telur     @map("kualitas-telur")
  statistik_produksi @map("statistik-produksi")
  riwayat_aktivitas  @map("riwayat-aktivitas")
}

enum FileFormat {
  pdf
  excel
  csv
}

enum DeviceType {
  esp32_cam_ai_scanner
  esp32_devkit_controller
}

enum DeviceStatus {
  online
  offline
  error
  maintenance
}

enum BatchStatus {
  active
  completed
  cancelled
}

// ============================================
// MODELS
// ============================================

model User {
  user_id           Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  password_hash     String    @db.VarChar(255)
  role              UserRole  @default(admin)
  phone             String?   @db.VarChar(20)
  bio               String?   @db.Text
  avatar_url        String?   @db.VarChar(500)
  email_verified_at DateTime?
  is_active         Boolean   @default(true)
  created_by        Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // Self-relation: who created this user
  creator  User?  @relation("UserCreatedBy", fields: [created_by], references: [user_id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  // Relations
  reports Report[]

  @@index([role], name: "idx_users_role")
  @@index([is_active], name: "idx_users_active")
  @@map("users")
}

model EggScan {
  scan_id       Int        @id @default(autoincrement())
  egg_code      String     @unique @db.VarChar(50)
  quality       EggQuality
  ai_confidence Decimal?   @db.Decimal(5, 4)
  quality_score Decimal?   @db.Decimal(5, 2)
  image         String?    @db.VarChar(500)
  weight        Decimal?   @db.Decimal(6, 2)
  length        Decimal?   @db.Decimal(5, 2)
  width         Decimal?   @db.Decimal(5, 2)
  height        Decimal?   @db.Decimal(5, 2)
  scanned_at    DateTime   @default(now())
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  @@index([quality], name: "idx_egg_scans_quality")
  @@index([scanned_at], name: "idx_egg_scans_scanned_at")
  @@map("egg_scans")
}

model Report {
  report_id      Int        @id @default(autoincrement())
  user_id        Int
  report_name    String     @db.VarChar(255)
  report_type    ReportType
  parameters     Json?
  file_format    FileFormat
  file_path      String     @db.VarChar(500)
  file_size      BigInt?
  generated_at   DateTime   @default(now())
  expires_at     DateTime?
  download_count Int        @default(0)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], name: "idx_reports_user_id")
  @@index([report_type], name: "idx_reports_type")
  @@index([generated_at], name: "idx_reports_generated_at")
  @@map("reports")
}

model Esp32Device {
  device_id        Int          @id @default(autoincrement())
  device_name      String       @db.VarChar(255)
  device_type      DeviceType
  mac_address      String       @unique @db.VarChar(17)
  ip_address       String?      @db.VarChar(15)
  wifi_ssid        String?      @db.VarChar(100)
  firmware_version String?      @db.VarChar(20)
  status           DeviceStatus @default(offline)
  last_seen        DateTime?
  is_active        Boolean      @default(true)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  @@index([status], name: "idx_esp32_devices_status")
  @@index([device_type], name: "idx_esp32_devices_type")
  @@map("esp32_devices")
}

model ProductionBatch {
  batch_id        Int         @id @default(autoincrement())
  batch_code      String      @unique @db.VarChar(50)
  batch_name      String      @db.VarChar(255)
  production_date DateTime    @db.Date
  total_eggs      Int         @default(0)
  good_eggs       Int         @default(0)
  bad_eggs        Int         @default(0)
  uncertain_eggs  Int         @default(0)
  status          BatchStatus @default(active)
  notes           String?     @db.Text
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  @@index([production_date], name: "idx_production_batches_date")
  @@index([status], name: "idx_production_batches_status")
  @@map("production_batches")
}
